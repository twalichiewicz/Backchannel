{
	"name": "backchannel",
	"main": "worker.js",
	"compatibility_date": "2026-09-11",
	"triggers": {
		"crons": ["* * * * *"]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issues": {
			"enabled": false
		}
	},
	"build": {
		"command": "npm ci --prefix account --ignore-scripts --no-audit --no-fund",
		"watch_dir": [
			"worker.js",
			"account/worker.mjs",
			"account/devices.mjs",
			"account/package.json",
			"account/package-lock.json"
		]
	},
	"assets": {
		"directory": "./site",
		"binding": "ASSETS",
		"run_worker_first": [
			"/",
			"/account",
			"/account/*"
		]
	},
	"send_email": [
		{
			"name": "ACCOUNT_EMAIL",
			"allowed_sender_addresses": ["accounts@backchnnl.app"]
		}
	],
	"vars": {
		"ACCOUNT_EMAIL_FROM": "accounts@backchnnl.app",
		"ACCOUNT_EMAIL_HOURLY_LIMIT": "120"
	},
	"d1_databases": [
		{
			"binding": "ACCOUNTS_DB",
			"database_name": "backchannel-accounts-v2",
			"database_id": "d1770976-e972-4d00-99e4-d21db317e843",
			"migrations_dir": "account/migrations"
		}
	],
	"analytics_engine_datasets": [
		{
			"binding": "BACKCHANNEL_DIAGNOSTICS",
			"dataset": "backchannel_diagnostics"
		}
	],
	"ratelimits": [
		{
			"name": "ACCOUNT_RATE_LIMIT",
			"namespace_id": "1129618216",
			"simple": {
				"limit": 24,
				"period": 60
			}
		}
	]
}
